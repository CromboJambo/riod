type            = process
command         = /usr/local/bin/riod daemon --socket-path /run/riod.sock --ledger-path /var/log/riod/events.jsonl --poll-interval-s 30 --idle-cpu-percent 5 --idle-gpu-percent 10 --idle-sample-count 6
logfile         = /var/log/dinit/riod.log
smooth-recovery = true
depends-on      = network.target
